# ==============================================================================
# CodeRival Frontend Environment Variables Example
# Copy this file to .env or .env.local and replace values for your environment.
# ==============================================================================

# Backend REST API Base URL (must include /api prefix)
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Real-Time WebSocket Gateway URL (Socket.IO server)
NEXT_PUBLIC_SOCKET_URL="http://localhost:8000"

# Application Environment Mode:
# "DEVELOPMENT" - disables strict fullscreen/blur anti-cheat lockdown for testing
# "PRODUCTION"  - enforces fullscreen, clipboard lock, and tab-blur detection during battles
NEXT_PUBLIC_APP_ENV="DEVELOPMENT"
