generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────────────────

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  CPP
  JAVA
  PYTHON
}

enum Verdict {
  AC  // Accepted
  WA  // Wrong Answer
  TLE // Time Limit Exceeded
  MLE // Memory Limit Exceeded
  RTE // Runtime Error
  CE  // Compilation Error
  IE  // Internal Error / Execution Engine Failure
}

enum SubmissionType {
  RUN    // Temporary sample execution ("Run Code")
  SUBMIT // Full problem submission ("Submit")
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  FINISHED
}

enum MatchStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum MatchResult {
  PLAYER1
  PLAYER2
  DRAW
  ABANDONED
}

enum MatchFinishReason {
  SOLUTION_ACCEPTED
  OPPONENT_CHEATED
  OPPONENT_SURRENDERED
  OPPONENT_DISCONNECTED
  TIMEOUT
  DRAW
}

// ─── USER & PROGRESSION ────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String?
  avatar_url   String?
  avatar_id    String?
  username     String  @unique
  country      String?

  // Competitive stats (denormalized for fast reads)
  rating         Int @default(1200)
  wins           Int @default(0)
  losses         Int @default(0)
  draws          Int @default(0)
  matchesPlayed  Int @default(0)
  problemsSolved Int @default(0)

  // OAuth & verification
  googleId      String?
  githubId      String?
  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  matchesAsPlayer1    Match[]         @relation("Player1")
  matchesAsPlayer2    Match[]         @relation("Player2")
  matchesWon          Match[]         @relation("Winner")
  submissions         Submission[]
  ratingHistory       RatingHistory[]
  sentFriendships     Friendship[]    @relation("SentFriendships")
  receivedFriendships Friendship[]    @relation("ReceivedFriendships")

  createdTournaments          Tournament[]            @relation("CreatedTournaments")
  tournamentsWon              Tournament[]            @relation("TournamentWinner")
  tournamentParticipants     TournamentParticipant[]
  receivedTournamentInvites   TournamentInvite[]      @relation("ReceivedTournamentInvites")
  tournamentMatchesPlayer1    TournamentMatch[]       @relation("TournamentMatchPlayer1")
  tournamentMatchesPlayer2    TournamentMatch[]       @relation("TournamentMatchPlayer2")
  tournamentMatchesWon        TournamentMatch[]       @relation("TournamentMatchWinner")

  @@index([username])
  @@index([rating(sort: Desc)]) // Leaderboard queries
}

/// Tracks rating changes after each match for profile charts
model RatingHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  rating    Int      // Rating after match
  delta     Int      // Change amount (+25 or -15)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── PROBLEM BANK ──────────────────────────────────────────

model Problem {
  id            String     @id @default(cuid())
  problemNumber Int        @unique
  title         String
  slug          String     @unique
  difficulty    Difficulty
  description   String     @db.Text // Supports markdown
  constraints   String     @db.Text
  timeLimitMs   Int        @default(1000)
  memoryLimitMb Int        @default(256)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  topics       Topic[]
  examples     ProblemExample[]
  signature    ProblemSignature?    // Function metadata (one-to-one)
  starterCodes ProblemStarterCode[] // Skeleton per language
  testCases    ProblemTestCase[]
  matches      Match[]
  submissions  Submission[]
}

model Topic {
  id       String    @id @default(cuid())
  name     String    @unique
  problems Problem[]
}

/// Display-only examples shown in the problem description (with explanations)
model ProblemExample {
  id          String  @id @default(cuid())
  problemId   String
  problem     Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input       String  @db.Text
  output      String  @db.Text
  explanation String? @db.Text
  order       Int
}

// ─── SIGNATURE & STARTER CODE ──────────────────────

/// Language-agnostic function metadata used for UI display and driver generation
/// Example params: [{"name": "nums", "type": "int[]"}, {"name": "target", "type": "int"}]
model ProblemSignature {
  id           String  @id @default(cuid())
  problemId    String  @unique
  problem      Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  functionName String  // e.g. "twoSum"
  returnType   String  // e.g. "int[]"
  params       Json    // Ordered array of {name, type} objects
}

/// The class/function skeleton the user sees in the editor
model ProblemStarterCode {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language  Language
  code      String   @db.Text

  @@unique([problemId, language])
}

// ─── TEST CASES ────────────────────────────────────────────

/// Judge test cases stored as JSON
/// input: positional args array, e.g. [[2,7,11,15], 9]
/// expected: expected return value, e.g. [0,1]
model ProblemTestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     Json    // Positional args matching param order
  expected  Json    // Expected return value
  order     Int     // Deterministic execution order
  isSample  Boolean @default(false) // true = can be shown on failed submission
}

// ─── MATCHES (1v1 BATTLES) ─────────────────────────────────

model Match {
  id        String      @id @default(cuid())
  player1Id String
  player1   User        @relation("Player1", fields: [player1Id], references: [id])
  player2Id String
  player2   User        @relation("Player2", fields: [player2Id], references: [id])
  problemId String
  problem   Problem     @relation(fields: [problemId], references: [id])

  status    MatchStatus        @default(WAITING)
  winnerId  String?
  winner    User?              @relation("Winner", fields: [winnerId], references: [id])
  result    MatchResult?
  reason    MatchFinishReason?

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  submissions       Submission[]
  ratingHistories   RatingHistory[]
  tournamentMatches TournamentMatch[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([status])
}

// ─── SUBMISSIONS ───────────────────────────────────────────

model Submission {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId      String
  problem        Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  matchId        String?
  match          Match?           @relation(fields: [matchId], references: [id], onDelete: SetNull)

  submissionType SubmissionType   @default(SUBMIT)
  language       Language
  sourceCode     String           @db.Text
  status         SubmissionStatus @default(QUEUED)
  verdict        Verdict?

  runtimeMs       Int?
  memoryKb        Int?
  totalTestCases  Int              @default(0)
  passedTestCases Int              @default(0)
  stderr          String?          @db.Text
  testCaseResults Json?

  submittedAt DateTime @default(now())

  @@index([userId])
  @@index([problemId])
  @@index([matchId])
}

// ─── FRIENDSHIPS ───────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

// ─── TOURNAMENT MODELS (8-PLAYER SINGLE ELIMINATION) ──────

enum TournamentStatus {
  WAITING_FOR_PLAYERS
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum TournamentMatchRound {
  QUARTERFINALS
  SEMIFINALS
  FINALS
}

model Tournament {
  id          String           @id @default(cuid())
  title       String           @default("Championship")
  maxPlayers  Int              @default(8)
  creatorId   String
  creator     User             @relation("CreatedTournaments", fields: [creatorId], references: [id])
  status      TournamentStatus @default(WAITING_FOR_PLAYERS)
  winnerId    String?
  winner      User?            @relation("TournamentWinner", fields: [winnerId], references: [id])

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  participants TournamentParticipant[]
  matches      TournamentMatch[]
  invites      TournamentInvite[]

  @@index([creatorId])
  @@index([status])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  seed         Int        // 1 to 8
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@unique([tournamentId, seed])
}

model TournamentInvite {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  senderId     String
  receiverId   String
  receiver     User       @relation("ReceivedTournamentInvites", fields: [receiverId], references: [id], onDelete: Cascade)
  status       String     @default("PENDING") // PENDING, ACCEPTED, DECLINED

  createdAt    DateTime   @default(now())

  @@unique([tournamentId, receiverId])
}

model TournamentMatch {
  id           String               @id @default(cuid())
  tournamentId String
  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        TournamentMatchRound
  matchIndex   Int                  // 0..3 QF, 0..1 SF, 0 Finals

  player1Id    String?
  player1      User?                @relation("TournamentMatchPlayer1", fields: [player1Id], references: [id])
  player2Id    String?
  player2      User?                @relation("TournamentMatchPlayer2", fields: [player2Id], references: [id])

  winnerId     String?
  winner       User?                @relation("TournamentMatchWinner", fields: [winnerId], references: [id])

  matchId      String?
  match        Match?               @relation(fields: [matchId], references: [id])

  nextMatchId  String?
  nextMatchSlot Int?                // 1 or 2

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}