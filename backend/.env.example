# ==============================================================================
# CodeRival Backend Environment Variables Example
# Copy this file to .env and replace placeholder values with your own.
# ==============================================================================

# Server Environment & Networking
NODE_ENV=development
PORT=8000

# Client & CORS Configuration
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000

# PostgreSQL Database (Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coderival?schema=public"

# Redis Configuration (Cache, BullMQ Queue, Rate Limiter)
# Default mapped port from docker-compose.yml is 6380
REDIS_URL="redis://localhost:6380"

# JWT Authentication Secret (MUST be a strong, unique secret in production)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"

# OAuth 2.0 Providers (Required for Google and GitHub authentication)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Code Execution Engine (Piston API)
# URL of the Piston execution engine (local container or hosted instance)
PISTON_URL="http://localhost:2000"

# BullMQ Submission Worker Concurrency (Default: 5)
SUBMISSION_WORKER_CONCURRENCY=5

# Email Delivery (Resend - used for OTP verification and password reset)
RESEND_API_KEY=""

# ImageKit (CDN & Avatar Image Uploads)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Support & Contact
SUPPORT_EMAIL="support@coderival.com"
